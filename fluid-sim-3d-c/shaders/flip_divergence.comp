#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 3) readonly buffer GridVelocity { vec4 velocity[]; };
layout(std430, binding = 5) buffer Divergence { float divergence[]; };

uniform ivec3 u_grid;
uniform int u_grid_cells;
uniform float u_dx;

int grid_index(ivec3 c) { return (c.z * u_grid.y + c.y) * u_grid.x + c.x; }
ivec3 grid_coord(uint id) {
    int x = int(id) % u_grid.x;
    int yz = int(id) / u_grid.x;
    return ivec3(x, yz % u_grid.y, yz / u_grid.y);
}
vec3 sample_velocity(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, u_grid))) return vec3(0.0);
    return velocity[grid_index(c)].xyz;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u_grid_cells) || velocity[id].w < 0.5) {
        if (id < uint(u_grid_cells)) divergence[id] = 0.0;
        return;
    }
    ivec3 c = grid_coord(id);
    float div = sample_velocity(c + ivec3(1,0,0)).x - sample_velocity(c - ivec3(1,0,0)).x;
    div += sample_velocity(c + ivec3(0,1,0)).y - sample_velocity(c - ivec3(0,1,0)).y;
    div += sample_velocity(c + ivec3(0,0,1)).z - sample_velocity(c - ivec3(0,0,1)).z;
    divergence[id] = div / (2.0 * u_dx);
}
