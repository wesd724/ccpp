#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 2) buffer GridAccum { ivec4 accum[]; };
layout(std430, binding = 3) buffer GridVelocity { vec4 velocity[]; };
layout(std430, binding = 4) buffer GridVelocityOld { vec4 velocity_old[]; };
layout(std430, binding = 5) buffer Divergence { float divergence[]; };
layout(std430, binding = 6) buffer PressureA { float pressure_a[]; };
layout(std430, binding = 7) buffer PressureB { float pressure_b[]; };

uniform int u_grid_cells;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u_grid_cells)) return;
    accum[id] = ivec4(0);
    velocity[id] = vec4(0.0);
    velocity_old[id] = vec4(0.0);
    divergence[id] = 0.0;
    pressure_a[id] = 0.0;
    pressure_b[id] = 0.0;
}
