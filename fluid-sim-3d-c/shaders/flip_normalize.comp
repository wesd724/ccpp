#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 2) readonly buffer GridAccum { ivec4 accum[]; };
layout(std430, binding = 3) buffer GridVelocity { vec4 velocity[]; };
layout(std430, binding = 4) buffer GridVelocityOld { vec4 velocity_old[]; };

uniform int u_grid_cells;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u_grid_cells)) return;
    if (accum[id].w > 8) {
        vec3 normalized_velocity = vec3(accum[id].xyz) * (4.0 / float(accum[id].w));
        velocity[id] = vec4(normalized_velocity, 1.0);
        velocity_old[id] = vec4(normalized_velocity, 1.0);
    } else {
        velocity[id] = vec4(0.0);
        velocity_old[id] = vec4(0.0);
    }
}
