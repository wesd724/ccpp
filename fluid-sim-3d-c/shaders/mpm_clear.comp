#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer GridAccum { ivec4 accum[]; };
layout(std430, binding = 2) buffer GridVelocity { vec4 grid_velocity[]; };
uniform int u_grid_cells;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u_grid_cells)) return;
    accum[id] = ivec4(0);
    grid_velocity[id] = vec4(0.0);
}
