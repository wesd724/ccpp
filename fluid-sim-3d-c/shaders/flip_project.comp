#version 430 core

layout(local_size_x = 256) in;
layout(std430, binding = 3) buffer GridVelocity { vec4 velocity[]; };
layout(std430, binding = 6) readonly buffer Pressure { float pressure[]; };
uniform float u_dt;
uniform ivec3 u_grid;
uniform int u_grid_cells;
uniform float u_dx;

int grid_index(ivec3 c) { return (c.z * u_grid.y + c.y) * u_grid.x + c.x; }
ivec3 grid_coord(uint id) {
    int x = int(id) % u_grid.x;
    int yz = int(id) / u_grid.x;
    return ivec3(x, yz % u_grid.y, yz / u_grid.y);
}
float sample_pressure(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, u_grid))) return 0.0;
    int id = grid_index(c);
    return velocity[id].w > 0.5 ? pressure[id] : 0.0;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(u_grid_cells) || velocity[id].w < 0.5) return;
    ivec3 c = grid_coord(id);
    vec3 gradient;
    gradient.x = sample_pressure(c + ivec3(1,0,0)) - sample_pressure(c - ivec3(1,0,0));
    gradient.y = sample_pressure(c + ivec3(0,1,0)) - sample_pressure(c - ivec3(0,1,0));
    gradient.z = sample_pressure(c + ivec3(0,0,1)) - sample_pressure(c - ivec3(0,0,1));
    velocity[id].xyz -= u_dt * gradient / (2.0 * u_dx);
}
